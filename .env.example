# ─── INSTAGRAM GRAPH API (@aurum.cinema) ───────────────────────────
# Configure estas variáveis no Vercel (Settings → Environment Variables).
# Passo a passo completo no README.md.
#
# Token RECOMENDADO: System User token (Meta Business Suite) — começa com "EAA",
# não expira e libera as métricas de concorrentes (business_discovery).
# Permissões: instagram_basic, instagram_manage_insights, pages_show_list,
#             pages_read_engagement, business_management
#
# Alternativa: token do "Instagram Login" (começa com "IG") — expira em 60 dias
# e NÃO permite dados de concorrentes.
INSTAGRAM_ACCESS_TOKEN=seu_token_aqui

# ID da conta Instagram profissional (opcional — se vazio, é descoberto pelo token)
INSTAGRAM_ACCOUNT_ID=

# Opcionais
# INSTAGRAM_API=facebook          # força o fluxo: facebook | instagram
# INSTAGRAM_GRAPH_VERSION=v23.0

# ─── FILMES (aba Filmes) ───────────────────────────────────────────
# Mesma chave do projeto aurum-site (TMDB, "Chave da API v3")
TMDB_API_KEY=

# ─── NOTÍCIAS ──────────────────────────────────────────────────────
# Não precisa de chave: /api/news usa o RSS do Google News.
